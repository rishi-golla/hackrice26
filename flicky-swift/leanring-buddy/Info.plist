<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>LSUIElement</key>
	<true/>
	<key>VoiceTranscriptionProvider</key>
	<string>assemblyai</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Flicky uses your microphone so you can ask it financial questions</string>
	<key>NSScreenCaptureUsageDescription</key>
	<string>Flicky needs screen recording access to see what you're browsing and help you make smarter financial decisions.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Flicky uses speech recognition to transcribe your voice when you talk to it</string>

	<!-- Cloudflare Worker proxy URL — all API calls go through this so keys stay server-side -->
	<!-- Deploy worker/src/index.ts and paste the deployed URL here -->
	<key>FLICKY_WORKER_URL</key>
	<string>https://clicky-proxy.abhijithutla.workers.dev</string>

	<!-- Capital One Nessie API credentials -->
	<!-- Get from: https://nessieisreal.com — leave blank to run in demo mode -->
	<key>FLICKY_NESSIE_API_KEY</key>
	<string></string>

	<!-- Nessie customer ID for the demo account -->
	<key>FLICKY_NESSIE_CUSTOMER_ID</key>
	<string></string>

	<!-- Optional: specific Nessie account ID (if empty, uses first account found) -->
	<key>FLICKY_NESSIE_ACCOUNT_ID</key>
	<string></string>

	<!-- "dollars" or "cents" — must match your Nessie sandbox configuration -->
	<key>FLICKY_NESSIE_AMOUNT_UNIT</key>
	<string>dollars</string>

	<!-- Nessie sandbox base URL (default: https://prod-api.nessieisreal.com) -->
	<key>FLICKY_NESSIE_BASE_URL</key>
	<string>https://prod-api.nessieisreal.com</string>
</dict>
</plist>
