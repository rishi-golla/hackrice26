{
  "name": "cappy",
  "version": "0.1.0",
  "private": true,
  "description": "Cappy financial assistant for grounded purchase cash-flow previews",
  "main": "dist/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "start": "electron .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:stress": "vitest run tests/stress",
    "test:e2e": "node scripts/e2e.mjs",
    "package:mac": "npm run build && electron-builder --mac dir",
    "package:win": "npm run build && electron-builder --win dir",
    "bench:fixture": "node scripts/capture-checkout-fixture.mjs",
    "bench:hover": "npm run build && node scripts/measure-hover-latency.mjs"
  },
  "dependencies": {
    "@11labs/client": "^0.2.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "dotenv": "^16.4.0",
    "fastify": "^5.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tesseract.js": "^6.0.0",
    "uiohook-napi": "^1.5.5",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "electron": "^40.0.0",
    "electron-builder": "^26.0.0",
    "esbuild": "^0.25.0",
    "jsdom": "^26.0.0",
    "playwright": "^1.50.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  }
}
