  "devDependencies": {"electron":"^40.0.0","electron-builder":"^26.0.0","esbuild":"^0.25.0","vite":"^6.0.0","typescript":"^5.7.0","vitest":"^3.0.0","jsdom":"^26.0.0","@types/node":"^22.0.0","@types/react":"^19.0.0","@types/react-dom":"^19.0.0","@testing-library/react":"^16.0.0","@testing-library/user-event":"^14.0.0","playwright":"^1.50.0"}
}
