FLICKY_DATA_MODE=synthetic
FLICKY_SESSION_TOKEN=replace-with-at-least-32-random-characters
FLICKY_TIMEZONE=America/Chicago

# Set FLICKY_DATA_MODE=live-sandbox and fill these in to read a real Nessie
# sandbox account instead of the synthetic fixture. Never commit a real key.
# See docs/provider-contracts.md for the verified contract.
NESSIE_API_KEY=
NESSIE_ACCOUNT_ID=
NESSIE_BASE_URL=https://api.nessieisreal.com

# Server-side ElevenLabs configuration. Never expose these to the renderer.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=RXtWW6etvimS8QJ5nhVk
ELEVENLABS_STT_MODEL_ID=scribe_v2
ELEVENLABS_TTS_MODEL_ID=eleven_flash_v2_5
ELEVENLABS_TIMEOUT_MS=15000
ELEVENLABS_ZERO_RETENTION=false
